[
  {
    "id": "j-minutes",
    "name": "会议纪要",
    "cat": "文档",
    "desc": "要点 + 决议 + 行动项，直接发群里。",
    "io": [
      {
        "k": "title",
        "l": "会议主题",
        "t": "text"
      },
      {
        "k": "date",
        "l": "日期",
        "t": "text"
      },
      {
        "k": "who",
        "l": "参会人",
        "t": "text"
      },
      {
        "k": "notes",
        "l": "原始记录 / 要点",
        "t": "area"
      }
    ],
    "tpl": "# 会议纪要 · {{title}}\n日期: {{date}}\n参会: {{who}}\n\n## 主要议题\n{{notes}}\n\n## 决议\n- \n\n## 行动项\n| 事项 | 负责人 | 截止 |\n|---|---|---|\n|  |  |  |\n",
    "fn": null,
    "out": "md",
    "lang": null,
    "ext": "md",
    "mode": "just-working"
  },
  {
    "id": "j-weekly",
    "name": "工作周报",
    "cat": "文档",
    "desc": "本周做了什么、结果、下周计划，三段式。",
    "io": [
      {
        "k": "name",
        "l": "姓名 / 团队",
        "t": "text"
      },
      {
        "k": "week",
        "l": "周期",
        "t": "text"
      }
    ],
    "tpl": "# 周报 · {{name}} ({{week}})\n\n## 本周完成\n- \n- \n## 关键结果 / 数据\n- \n## 风险与需要支持\n- \n## 下周计划\n- \n",
    "fn": null,
    "out": "md",
    "lang": null,
    "ext": "md",
    "mode": "just-working"
  },
  {
    "id": "j-monthly",
    "name": "月度总结",
    "cat": "文档",
    "desc": "成果、问题、下月重点，向上汇报用。",
